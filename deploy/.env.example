AI_NOVEL_PORT=8080
AI_NOVEL_RUNTIME_LEASE_SECONDS=90
AI_NOVEL_RUNTIME_HEARTBEAT_SECONDS=10
# Apply known checksummed migrations during Web startup before the Worker begins.
AI_NOVEL_AUTO_MIGRATE=1
# Optional: require this token for credential and migration mutation endpoints.
AI_NOVEL_ADMIN_TOKEN=
# Optional: provide a Fernet key through your secret manager instead of the generated /data/.ai-novel-master.key file.
AI_NOVEL_MASTER_KEY=
