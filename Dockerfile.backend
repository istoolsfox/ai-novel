FROM python:3.12-slim

ARG APP_VERSION=1.0.0-rc.1
ARG VCS_REF=""
ARG BUILD_DATE=""

LABEL org.opencontainers.image.title="AI Novel Workbench Backend" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.source="https://github.com/wlxb625/ai-novel"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    AI_NOVEL_VERSION=${APP_VERSION} \
    AI_NOVEL_BUILD_COMMIT=${VCS_REF} \
    AI_NOVEL_BUILD_DATE=${BUILD_DATE}

WORKDIR /app

COPY VERSION /app/VERSION
COPY backend/requirements.txt /app/backend/requirements.txt
RUN python -m pip install --upgrade pip && python -m pip install -r /app/backend/requirements.txt

COPY backend /app/backend

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
